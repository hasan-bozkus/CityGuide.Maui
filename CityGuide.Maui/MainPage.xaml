<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CityGuide.Maui.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">

            <Label Text="Mardin Şehir Rehberi"
                   FontSize="35"
                   FontAttributes="Bold"
                   TextColor="LightSalmon"
                   HorizontalOptions="Center" />

            <Label Text="Türkiye'nin tarihi ve antik kenti Mardin hakkında bilgiler."
                   FontSize="16"
                   HorizontalTextAlignment="Center"
                   TextColor="Gray" />

            <Frame BackgroundColor="LightYellow"
                   CornerRadius="30"
                   Padding="15">
                <VerticalStackLayout>
                    <Label Text="Hatuniye Medresesi (Sitti Radviyye Medresesi)"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="#0D47A1" />
                    <Label Text="İçinde Hz. Muhammed (SAV)'e ait olduğu kabul edilen bir kadem-i şerif (ayak izi) barındıran, Artuklu döneminden kalma tarihi medrese."
                           FontSize="15"
                           TextColor="Black" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Rezervasyon Yap"
                    BackgroundColor="RosyBrown"
                    TextColor="White"
                    CornerRadius="20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>