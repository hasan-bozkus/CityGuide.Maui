<?xml version="1.0" encoding="utf-8" ?>
<!--
    Bu dosyayı App.xaml içindeki <Application.Resources><ResourceDictionary>
    bölümüne <ResourceDictionary Source="MardinColors.xaml" /> olarak
    merge edin (Resources/Styles klasörüne kopyalayabilirsiniz).
    Renkler, orijinal HTML/Tailwind paletinden alınmıştır.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="SurfaceIvory">#FDFCFB</Color>
    <Color x:Key="MardinSand">#C5A880</Color>
    <Color x:Key="TerracottaSunset">#D35400</Color>
    <Color x:Key="MesopotamianBlue">#008080</Color>
    <Color x:Key="DeepNavy">#003580</Color>

    <Color x:Key="Primary">#725B38</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="PrimaryContainer">#C5A880</Color>
    <Color x:Key="OnPrimaryContainer">#513D1D</Color>

    <Color x:Key="Secondary">#006A6A</Color>
    <Color x:Key="OnSecondary">#FFFFFF</Color>
    <Color x:Key="SecondaryContainer">#90EFEF</Color>
    <Color x:Key="OnSecondaryContainer">#006E6E</Color>

    <Color x:Key="Tertiary">#A23F00</Color>
    <Color x:Key="OnTertiary">#FFFFFF</Color>
    <Color x:Key="TertiaryContainer">#FF8E58</Color>
    <Color x:Key="OnTertiaryContainer">#712A00</Color>

    <Color x:Key="Background">#FBF9F6</Color>
    <Color x:Key="OnBackground">#1B1C1A</Color>
    <Color x:Key="Surface">#FBF9F6</Color>
    <Color x:Key="OnSurface">#1B1C1A</Color>
    <Color x:Key="OnSurfaceVariant">#4D463C</Color>
    <Color x:Key="Outline">#7F766A</Color>
    <Color x:Key="OutlineVariant">#D1C5B8</Color>

    <Color x:Key="Error">#BA1A1A</Color>
    <Color x:Key="OnError">#FFFFFF</Color>

</ResourceDictionary>
