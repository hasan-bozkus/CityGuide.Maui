<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CityGuide.Maui"
             xmlns:controls="clr-namespace:CityGuide.Maui.Views"
             x:Class="CityGuide.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/MardinColors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ControlTemplate x:Key="MainLayoutTemplate">
                <Grid RowDefinitions="*, Auto">
                    <!-- Üst Kısım: Sayfanın Kendi İçeriği -->
                    <ContentPresenter Grid.Row="0" />

                    <!-- Alt Kısım: Sabit TabBar Layout -->
                    <controls:CustomTabBarPage Grid.Row="1" />
                </Grid>
            </ControlTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
